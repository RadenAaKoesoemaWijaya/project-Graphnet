# =============================================================================
# ASTINA PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# This is a template for production deployment.
# NEVER commit actual production values to version control.
# Generate secure passwords using: python -c "import secrets; print(secrets.token_urlsafe(16))"
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
PORT=8501
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=3072
STREAMLIT_SERVER_MAX_MESSAGE_SIZE=3072
ASTINA_LOG_FORMAT=json

# =============================================================================
# AUTHENTICATION - PRODUCTION MODE
# =============================================================================
# SECURITY WARNING: Set AUTH_ENABLED=true for production deployment
# Generate unique secure passwords for each role using:
# python -c "import secrets; print('Admin:', secrets.token_urlsafe(16)); print('Auditor:', secrets.token_urlsafe(16)); print('Analyst:', secrets.token_urlsafe(16)); print('Viewer:', secrets.token_urlsafe(16))"
AUTH_ENABLED=true
ASTINA_ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION_MIN_12_CHARS
ASTINA_AUDITOR_PASSWORD=CHANGE_THIS_IN_PRODUCTION_MIN_12_CHARS
ASTINA_ANALYST_PASSWORD=CHANGE_THIS_IN_PRODUCTION_MIN_12_CHARS
ASTINA_VIEWER_PASSWORD=CHANGE_THIS_IN_PRODUCTION_MIN_12_CHARS

# =============================================================================
# LLM & COPILOT CONFIGURATION
# =============================================================================
# Provider Options: heuristic, gemini, openai, ollama
LLM_PROVIDER=heuristic
LLM_MODEL_NAME=gemini-1.5-flash
LLM_ENDPOINT_URL=http://localhost:11434/api/generate
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# API Keys (Optional - only if using cloud LLM providers)
# Generate secure API keys and store in Secret Manager for production
GEMINI_API_KEY=CHANGE_THIS_IN_PRODUCTION_OR_USE_SECRET_MANAGER
OPENAI_API_KEY=CHANGE_THIS_IN_PRODUCTION_OR_USE_SECRET_MANAGER

# =============================================================================
# GOOGLE CLOUD STORAGE (Optional)
# =============================================================================
# For model persistence across Cloud Run instances
GOOGLE_CLOUD_BUCKET=your-production-bucket-name-here

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
OPTUNA_N_JOBS=4
CV_N_JOBS=4

# =============================================================================
# DATABASE CONFIGURATION (Optional)
# =============================================================================
# Only required if you want to use database backend
ENABLE_DATABASE=0
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_IN_PRODUCTION_OR_USE_SECRET_MANAGER
DB_NAME=astina
DB_POOL_SIZE=10
DB_TIMEOUT=5

# =============================================================================
# AUDIT TRAIL CONFIGURATION
# =============================================================================
AUDIT_TRAIL_LOG_PATH=logs/audit_trail.jsonl