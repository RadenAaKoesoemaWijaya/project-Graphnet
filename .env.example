# =============================================================================
# ASTINA Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8501
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=3072
STREAMLIT_SERVER_MAX_MESSAGE_SIZE=3072
ASTINA_LOG_FORMAT=json

# =============================================================================
# Google Cloud Storage (Optional)
# =============================================================================
GOOGLE_CLOUD_BUCKET=your-bucket-name-here

# =============================================================================
# Performance Configuration
# =============================================================================
OPTUNA_N_JOBS=4
CV_N_JOBS=4

# =============================================================================
# LLM & Copilot Configuration
# =============================================================================
# Provider Options: heuristic, gemini, openai, ollama
LLM_PROVIDER=heuristic
LLM_MODEL_NAME=gemini-1.5-flash
LLM_ENDPOINT_URL=http://localhost:11434/api/generate
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# API Keys (Required for cloud providers)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Authentication Configuration
# =============================================================================
# ⚠️ SECURITY WARNING: Set AUTH_ENABLED=true for production deployment
# Development mode (AUTH_ENABLED=false) uses default passwords for convenience only
# NEVER use default passwords in production environments
AUTH_ENABLED=false

# Production Passwords (REQUIRED when AUTH_ENABLED=true)
# Generate secure passwords using: python -c "import secrets; print(secrets.token_urlsafe(16))"
# Each password should be at least 12 characters with mixed case, numbers, and symbols
ASTINA_ADMIN_PASSWORD=CHANGE_THIS_IN_PRODUCTION
ASTINA_AUDITOR_PASSWORD=CHANGE_THIS_IN_PRODUCTION
ASTINA_ANALYST_PASSWORD=CHANGE_THIS_IN_PRODUCTION
ASTINA_VIEWER_PASSWORD=CHANGE_THIS_IN_PRODUCTION

# =============================================================================
# Database Configuration (Optional)
# =============================================================================
# Only required if you want to use database backend
ENABLE_DATABASE=0
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=astina
DB_POOL_SIZE=10
DB_TIMEOUT=5

# =============================================================================
# Audit Trail Configuration
# =============================================================================
AUDIT_TRAIL_LOG_PATH=logs/audit_trail.jsonl