# =============================================================================
# ASTINA Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# =============================================================================

# =============================================================================
# Server Configuration
# =============================================================================
PORT=8501
STREAMLIT_SERVER_MAX_UPLOAD_SIZE=3072
ASTINA_LOG_FORMAT=json

# =============================================================================
# Google Cloud Storage (Optional)
# =============================================================================
GOOGLE_CLOUD_BUCKET=your-bucket-name-here

# =============================================================================
# Performance Configuration
# =============================================================================
OPTUNA_N_JOBS=4
CV_N_JOBS=4

# =============================================================================
# LLM & Copilot Configuration
# =============================================================================
# Provider Options: heuristic, gemini, openai, ollama
LLM_PROVIDER=heuristic
LLM_MODEL_NAME=gemini-1.5-flash
LLM_ENDPOINT_URL=http://localhost:11434/api/generate
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# API Keys (Required for cloud providers)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# Authentication Configuration
# =============================================================================
# Set to "true" for production mode with enforced authentication
AUTH_ENABLED=false

# Default passwords (only used in development mode if AUTH_ENABLED=false)
# For production, set AUTH_ENABLED=true and use these passwords
ASTINA_ADMIN_PASSWORD=AdminAstina2026!
ASTINA_AUDITOR_PASSWORD=AuditorAstina2026!
ASTINA_ANALYST_PASSWORD=AnalystAstina2026!
ASTINA_VIEWER_PASSWORD=ViewerAstina2026!

# =============================================================================
# Database Configuration (Optional)
# =============================================================================
# Only required if you want to use database backend
ENABLE_DATABASE=0
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_NAME=astina
DB_POOL_SIZE=10
DB_TIMEOUT=5

# =============================================================================
# Audit Trail Configuration
# =============================================================================
AUDIT_TRAIL_LOG_PATH=logs/audit_trail.jsonl